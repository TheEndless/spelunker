{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Spelunker",
  "version": "0.1.0",
  "identifier": "dev.skean.spelunker",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Spelunker", "width": 1280, "height": 780, "minWidth": 900, "minHeight": 520, "dragDropEnabled": true, "create": false }],
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": [] }
    }
  },
  "mainBinaryName": "Spelunker",
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "publisher": "Spelunker",
    "category": "Utility",
    "shortDescription": "Fast file search for Windows",
    "longDescription": "Spelunker finds files by name and by what is inside them, across whole drives, and previews what it finds.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "installer-hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false
      },
      "wix": {
        "fragmentPaths": ["wix/folder-menu.wxs"],
        "componentRefs": ["ExplorerFolderMenu"]
      }
    }
  }
}
