{
  "name": "spelunker",
  "private": true,
  "version": "1.2.0",
  "description": "Fast Windows file search: find text inside files (grep GUI with regex and whole word), match file names with wildcards, filter by size and date, preview matches, and see results on a disk usage treemap. Rust, Tauri 2, Svelte 5.",
  "keywords": [
    "file-search",
    "search-in-files",
    "find-in-files",
    "grep-gui",
    "windows",
    "desktop",
    "regex",
    "wildcard",
    "treemap",
    "disk-usage",
    "tauri",
    "svelte",
    "rust"
  ],
  "homepage": "https://github.com/TheEndless/spelunker#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheEndless/spelunker.git"
  },
  "bugs": {
    "url": "https://github.com/TheEndless/spelunker/issues"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.1",
    "@tsconfig/svelte": "^5.0.8",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.2",
    "@tauri-apps/plugin-clipboard-manager": "^2.4.1"
  }
}
